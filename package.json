{
  "name": "obs-lite",
  "version": "1.0.0",
  "description": "Electron screen recorder",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win --nsis --portable -c.asar=false",
    "dist:mac": "electron-builder --mac"
  },
  "build": {
    "appId": "com.obslite.app",
    "productName": "OBS-Lite",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "28.2.0",
    "electron-builder": "^24.9.0"
  }
}
