{
  "name": "obs-lite",
  "version": "1.0.0",
  "description": "Electron screen recorder",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "npx electron-builder --win --dir -c.asar=false"
  },
  "build": {
    "appId": "com.obslite.app",
    "productName": "OBS-Lite",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "dir"
    }
  },
  "devDependencies": {
    "electron": "28.2.0",
    "electron-builder": "24.9.0"
  }
}
